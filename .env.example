# Copy to .env.local for local development. On Vercel, set these in
# Project Settings -> Environment Variables.

# Random secret for signing sessions: `npx auth secret` generates one.
AUTH_SECRET=

# Google OAuth client (Google Cloud Console -> APIs & Services -> Credentials).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Neon Postgres connection string. Set automatically when Neon is
# connected through the Vercel Marketplace.
DATABASE_URL=

# Comma-separated list of email domains allowed to sign in.
ALLOWED_EMAIL_DOMAINS=azumo.com,azumolabs.com
